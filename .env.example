# Magma MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: Amboss API key of an account that has accepted the Terms of Service
# at https://magma.amboss.tech/settings/account
# Get an API key at: https://account.amboss.tech/settings/api-keys
MAGMA_API_KEY=your_api_key_here

# Optional: Magma GraphQL endpoint (defaults to production endpoint)
# MAGMA_GRAPHQL_ENDPOINT=https://magma.amboss.tech/graphql

# Optional: Log level (debug, info, warn, error)
# LOG_LEVEL=info
